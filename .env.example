# Copy to .env and fill in. Never commit .env — it is gitignored.

# Turso / libSQL. A local file works for development:
#   TURSO_DATABASE_URL=file:./.cache/dev.db
# and needs no auth token. A remote database needs both.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-me

# The single administrator password checked by /admin/login.
ADMIN_PASSWORD=replace-me

# HMAC key for the admin session cookie. At least 32 characters:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=generate-at-least-32-random-bytes

# Only used by the Playwright suite, which builds its own throwaway database.
E2E_ADMIN_PASSWORD=e2e-admin-password
