# Copy to .env and fill in. Never commit .env — it is gitignored.

# Turso / libSQL — the vocabulary list. A local file works for development:
#   TURSO_DATABASE_URL=file:./.cache/dev.db
# and needs no auth token. A remote database needs both.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-me

# Firebase / Firestore — user accounts, quiz results, word statistics, badges.
# From a service account key: Firebase console → Project settings → Service
# accounts → Generate new private key. The JSON it downloads holds all three.
#
# FIREBASE_PRIVATE_KEY spans several lines. Keep it on one line wrapped in
# double quotes with the newlines escaped as \n, exactly as it appears in the
# JSON file — the app unescapes them at startup.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# HMAC key for the learner session cookie. At least 32 characters:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
USER_SESSION_SECRET=generate-at-least-32-random-bytes

# The single administrator password checked by /admin/login.
ADMIN_PASSWORD=replace-me

# HMAC key for the admin session cookie. At least 32 characters:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=generate-at-least-32-random-bytes

# Only used by the Playwright suite, which builds its own throwaway database.
E2E_ADMIN_PASSWORD=e2e-admin-password
